# Database (default: SQLite, no config needed)
# DATABASE_URL=sqlite+aiosqlite:///./openestimate.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/openestimate

# Auth
JWT_SECRET=change-me-in-production

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# S3/MinIO (optional)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# AI (optional — add your provider key)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Vector search backend (default: lancedb)
# VECTOR_BACKEND=lancedb

# Rate Limiting (requests per minute)
# API_RATE_LIMIT=100
# LOGIN_RATE_LIMIT=10
# AI_RATE_LIMIT=10

# Demo accounts (set to false in production)
# SEED_DEMO=true

# Email (SMTP) — outbound transport for password resets & notifications.
# Default backend "console" only logs the email; no real delivery.
# Set EMAIL_BACKEND=smtp + the SMTP_* fields below to enable real delivery.
#
# Microsoft 365 (Exchange Online) example:
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_TLS=true
#   SMTP_USER=noreply@yourdomain.com   # mailbox with SMTP AUTH enabled
#   SMTP_PASSWORD=<App Password>       # MFA → App Password (NOT your real password)
#   SMTP_FROM=noreply@yourdomain.com   # MUST match SMTP_USER on Exchange Online,
#                                      # otherwise: 5.7.60 "client does not have
#                                      # permissions to send as this sender"
#
# Notes:
#   - Port 587 = STARTTLS (use SMTP_TLS=true). Port 465 (implicit TLS) is
#     not supported by the current backend.
#   - Empty SMTP_HOST disables the smtp backend even if EMAIL_BACKEND=smtp;
#     the backend logs a loud warning instead of silently dropping mail.
# EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true

# Public URL used to build password-reset and notification links.
# Falls back to the first CORS origin if unset.
# FRONTEND_URL=http://localhost:5173
